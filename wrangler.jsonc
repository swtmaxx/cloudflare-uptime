{
  "name": "cloudflare-uptime",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-uptime-db",
      "database_id": "432fe77f-b10a-4cfe-a251-db805f1423c5",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QQ_GATEWAY",
        "class_name": "QQGateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QQGateway"
      ]
    },
    {
      // Remote already applied this class creation; keep tags aligned to
      // avoid re-running new_sqlite_classes on an existing DO (error 10074).
      "tag": "v2"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ]
}
