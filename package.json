{
    "name": "cloudflare-uptime",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "A fresh Cloudflare Worker and D1 uptime monitor with Worker and Globalping probes.",
    "scripts": {
        "build:client": "node scripts/build-client.mjs",
        "build": "npm run build:client",
        "dev": "npm run build:client && wrangler dev",
        "deploy": "npm run build:client && wrangler deploy",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test test/**/*.test.ts"
    },
    "dependencies": {
        "@types/qrcode": "^1.5.6",
        "hono": "^4.7.0",
        "qrcode": "^1.5.4",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260801.1",
        "@types/node": "^24.0.0",
        "esbuild": "^0.28.1",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3",
        "vite": "^8.2.1",
        "wrangler": "^4.119.0",
        "@vitejs/plugin-vue": "^6.0.8"
    }
}
