{
    "name": "cloudflare-uptime",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "A fresh Cloudflare Worker and D1 uptime monitor with Worker and Globalping probes.",
    "scripts": {
        "build:client": "node scripts/build-client.mjs",
        "build": "npm run build:client",
        "dev": "npm run build:client && wrangler dev",
        "dev:local": "npm run build:client && wrangler dev --local --config wrangler.local.jsonc --ip 0.0.0.0 --port 8788 --persist-to .wrangler/local-state",
        "deploy": "npm run build:client && wrangler deploy",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test test/**/*.test.ts"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "~1.2.36",
        "@fortawesome/free-regular-svg-icons": "~5.15.4",
        "@fortawesome/free-solid-svg-icons": "~5.15.4",
        "@fortawesome/vue-fontawesome": "~3.1.3",
        "@types/qrcode": "^1.5.6",
        "@vuepic/vue-datepicker": "~3.4.8",
        "@vvo/tzdb": "~6.198.0",
        "axios": "^0.33.0",
        "bootstrap": "^5.1.3",
        "chart.js": "~4.2.1",
        "chartjs-adapter-dayjs-4": "~1.0.0",
        "compare-versions": "~3.6.0",
        "country-flag-emoji-polyfill": "^0.1.10",
        "cronstrue": "^3.27.0",
        "dayjs": "~1.11.19",
        "dompurify": "~3.4.0",
        "favico.js": "^0.3.10",
        "hono": "^4.7.0",
        "jsonata": "^2.2.2",
        "marked": "~14.1.4",
        "mitt": "~3.0.1",
        "prismjs": "~1.30.0",
        "qrcode": "^1.5.4",
        "v-pagination-3": "^0.1.7",
        "validator": "^13.15.35",
        "vue": "^3.5.13",
        "vue-chartjs": "~5.2.0",
        "vue-contenteditable": "~3.0.0",
        "vue-i18n": "~11.2.8",
        "vue-multiselect": "~3.0.0",
        "vue-prism-editor": "~2.0.0-alpha.2",
        "vue-qrcode": "~1.0.1",
        "vue-router": "~4.2.5",
        "vue-toastification": "~2.0.0-rc.5",
        "vuedraggable": "~4.1.0",
        "whatwg-url": "^17.1.2"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260801.1",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "esbuild": "^0.28.1",
        "postcss-rtlcss": "~5.0.0",
        "postcss-scss": "~4.0.9",
        "sass": "^1.105.0",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3",
        "vite": "^8.2.1",
        "wrangler": "^4.119.0"
    },
    "license": "AGPL-3.0-only",
    "allowScripts": {
        "workerd@1.20260801.1": true,
        "esbuild@0.28.1": true
    }
}
